{
    "name": "newsong/song-search",
    "description": "A Statamic addon for searching and selecting songs from Spotify and Apple Music",
    "type": "statamic-addon",
    "version": "2.0.0",
    "license": "MIT",
    "keywords": [
        "statamic",
        "addon",
        "music",
        "spotify",
        "apple-music",
        "fieldtype"
    ],
    "homepage": "https://github.com/newsong/song-search",
    "authors": [
        {
            "name": "NewSong Church",
            "email": "tech@newsongpeople.com",
            "homepage": "https://newsongchurch.org"
        }
    ],
    "support": {
        "issues": "https://github.com/newsong/song-search/issues",
        "source": "https://github.com/newsong/song-search"
    },
    "require": {
        "php": "^8.5",
        "statamic/cms": "^6.0",
        "guzzlehttp/guzzle": "^7.0",
        "firebase/php-jwt": "^6.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "NewSong\\SongSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NewSong\\SongSearch\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "pint --test",
        "lint:fix": "pint"
    },
    "extra": {
        "statamic": {
            "name": "Song Search",
            "description": "Search and select songs from Spotify and Apple Music"
        },
        "laravel": {
            "providers": [
                "NewSong\\SongSearch\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
